@model List<LINCA_v1.Models.Cartitems>

@{
    ViewData["Title"] = "My Cart";
    var total = Model.Sum(x => x.TotalPrice);
}

<style>
    :root {
        --bg: #eef5e9;
        --grid: #d8e6d3;
        --card: #ffffffcc;
        --text: #0c1a0f;
        --muted: #2b3b2f;
        --primary: #a7d9a8;
        --primaryHover: #94c996;
        --danger: #e26d6d;
        --shadow: 0 18px 40px rgba(0,0,0,.08);
        --radius: 22px;
        --greenText: #2f8a3a;
    }

    body {
        margin: 0;
        font-family: 'Tageschrift', serif;
        color: var(--text);
        background-color: var(--bg);
        background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
        background-size: 40px 40px;
    }

    .hero {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px;
    }

    .hero-card {
        width: min(1000px, 100%);
        background: var(--card);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.55);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 40px;
    }

    .title {
        text-align: center;
        font-size: 42px;
        font-weight: 900;
        color: var(--greenText);
        letter-spacing: 4px;
        margin-bottom: 6px;
    }

    .subtitle {
        text-align: center;
        color: var(--muted);
        font-weight: 700;
        margin-bottom: 25px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 14px;
        border-bottom: 1px dashed rgba(0,0,0,.15);
        text-align: left;
        vertical-align: middle;
        font-weight: 700;
    }

    th {
        color: var(--muted);
        font-size: 13px;
    }

    .product {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .product img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid rgba(0,0,0,.1);
        }

    input[type=number], input[type=text], textarea {
        width: 100%;
        border-radius: 14px;
        border: 1px solid rgba(0,0,0,.15);
        padding: 10px 12px;
        font-weight: 700;
        outline: none;
        background: rgba(255,255,255,.85);
    }

    textarea {
        min-height: 90px;
    }

    .btn {
        border: 0;
        border-radius: 18px;
        padding: 10px 16px;
        font-weight: 900;
        cursor: pointer;
    }

    .btn-primary {
        background: var(--primary);
        color: var(--text);
    }

        .btn-primary:hover {
            background: var(--primaryHover);
        }

    .btn-danger {
        background: var(--danger);
        color: white;
    }

    .summary {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-top: 30px;
        flex-wrap: wrap;
        align-items: flex-start;
    }

    .total {
        font-size: 26px;
        font-weight: 900;
        color: var(--greenText);
    }

    .empty {
        text-align: center;
        padding: 40px 10px;
        font-weight: 800;
        color: var(--muted);
    }

    .section-title {
        font-weight: 900;
        color: var(--muted);
        margin: 14px 0 6px;
    }

    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    @@media (max-width: 720px) {
        .grid-2 {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="hero">
    <div class="hero-card">

        <div class="title">My Cart</div>
        <div class="subtitle">Review your items before checkout</div>

        @if (!Model.Any())
        {
            <div class="empty">
                🛒 Your cart is empty <br /><br />
                <a asp-controller="Market" asp-action="Shop" class="btn btn-primary">
                    Start Shopping
                </a>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th width="170">Qty</th>
                        <th>Total</th>
                        <th width="80"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="product">
                                    @if (!string.IsNullOrEmpty(item.ProductImage))
                                    {
                                        <img src="@item.ProductImage" />
                                    }
                                    <span>@item.ProductName</span>
                                </div>
                            </td>

                            <td>@item.Price.ToString("0.00") JD</td>

                            <td>
                                <form asp-controller="Cart" asp-action="UpdateQty" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                    <div style="display:flex; gap:8px; align-items:center;">
                                        <input type="number" name="quantity" min="1" value="@item.Quantity" />
                                        <button type="submit" class="btn btn-primary">Update</button>
                                    </div>
                                </form>
                            </td>

                            <td>@item.TotalPrice.ToString("0.00") JD</td>

                            <td>
                                <form asp-controller="Cart" asp-action="Remove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                    <button type="submit" class="btn btn-danger">✖</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="summary">
                <!-- Checkout form -->
                <form asp-controller="Cart" asp-action="Checkout" method="post" style="flex:1;">
                    @Html.AntiForgeryToken()

                    <div class="section-title">Delivery Info</div>

                    <div class="grid-2">
                        <div>
                            <label class="section-title" style="margin:0 0 6px;">Phone 1 *</label>
                            <input type="text" name="Phone1" placeholder="07* *** ****" required />
                        </div>

                        <div>
                            <label class="section-title" style="margin:0 0 6px;">Phone 2 (optional)</label>
                            <input type="text" name="Phone2" placeholder="07* *** ****" />
                        </div>
                    </div>

                    <div style="margin-top:12px;">
                        <label class="section-title" style="margin:0 0 6px;">Address *</label>
                        <textarea name="Address" placeholder="Your address and details..." required></textarea>
                    </div>

                    <div style="margin-top:12px;">
                        <label class="section-title" style="margin:0 0 6px;">Order Note (optional)</label>
                        <textarea name="Note" placeholder="Any notes for the seller..."></textarea>
                    </div>

                    <div style="margin-top:14px; text-align:center;">
                        <button type="submit" class="btn btn-primary">Checkout ✔</button>
                    </div>
                </form>

                <div style="text-align:right; min-width: 220px;">
                    <div class="subtitle" style="margin-bottom:6px;">Total</div>
                    <div class="total">@total.ToString("0.00") JD</div>
                </div>
            </div>
        }
    </div>
</div>