@model LINCA_v1.ViewModels.OrderSummaryVM
@{
    ViewData["Title"] = "Checkout";
}

<style>
    :root {
        --bg: #eef5e9;
        --grid: #d8e6d3;
        --card: #ffffffcc;
        --text: #0c1a0f;
        --muted: #2b3b2f;
        --primary: #a7d9a8;
        --primaryHover: #94c996;
        --danger: #e26d6d;
        --shadow: 0 18px 40px rgba(0,0,0,.08);
        --radius: 22px;
        --greenText: #2f8a3a;
    }

    body {
        margin: 0;
        font-family: 'Tageschrift', serif;
        color: var(--text);
        background-color: var(--bg);
        background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
        background-size: 40px 40px;
    }

    .hero {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px;
    }

    .hero-card {
        width: min(980px, 100%);
        background: var(--card);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.55);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 42px;
    }

    .title {
        text-align: center;
        font-size: 36px;
        font-weight: 900;
        color: var(--dark);
        margin-bottom: 4px;
    }

    .subtitle {
        text-align: center;
        color: var(--muted);
        font-weight: 700;
        margin-bottom: 18px;
    }

    .badge {
        display: inline-block;
        padding: 8px 14px;
        border-radius: 14px;
        font-weight: 700;
        background: rgba(167,217,168,.35);
        color: var(--dark);
        margin-top: 6px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 18px;
    }

    th, td {
        padding: 12px;
        border-bottom: 1px dashed rgba(0,0,0,.15);
        font-weight: 700;
        vertical-align: middle;
    }

    th {
        color: var(--muted);
        font-size: 13px;
    }

    td img {
        width: 52px;
        height: 52px;
        object-fit: cover;
        border-radius: 12px;
    }

    .line-total {
        text-align: right;
    }

    .summary-box {
        margin-top: 20px;
        background: #f6f2ea;
        border-radius: 16px;
        padding: 18px 22px;
        font-weight: 700;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--dark);
        font-size: 20px;
    }

    .btn {
        border-radius: 18px;
        padding: 10px 16px;
        font-weight: 900;
        cursor: pointer;
        border: 0;
    }

    .btn-primary {
        background: var(--primary);
        color: var(--text);
    }

        .btn-primary:hover {
            background: var(--primaryHover);
        }

    .btn-dark {
        background: var(--dark);
        color: #fff;
    }

    .btn-outline-secondary {
        background: transparent;
        border: 1px solid rgba(0,0,0,.15);
        color: var(--muted);
    }

    .d-flex {
        display: flex;
        gap: 10px;
    }

    .mt-4 {
        margin-top: 20px;
    }

    .gap-2 {
        gap: 12px;
    }
</style>

<div class="hero">
    <div class="hero-card">

        <div class="text-center mb-4">
            <div class="title">Order Summary</div>
            <div class="subtitle">Invoice / فاتورة</div>
            <div class="mt-2">
                <span class="badge">
                    Store: @Model.MarketName
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-muted">
                        <th>Item</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Unit</th>
                        <th class="text-end">Line Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var it in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(it.ImageUrl))
                                    {
                                        <img src="@it.ImageUrl" />
                                    }
                                    <div>
                                        <div style="font-weight:700;">@it.ProductName</div>
                                        <small class="text-muted">#@it.ProductId</small>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">@it.Quantity</td>
                            <td class="text-end">@it.UnitPrice.ToString("0.00") JD</td>
                            <td class="text-end">@it.LineTotal.ToString("0.00") JD</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="summary-box">
            <div>Total</div>
            <div>@Model.TotalPrice.ToString("0.00") JD</div>
        </div>

        <form asp-controller="Cart" asp-action="ConfirmOrder" method="post" class="mt-4">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Phone1" />
            <input type="hidden" asp-for="Phone2" />
            <input type="hidden" asp-for="Address" />
            <input type="hidden" asp-for="Note" />
            <input type="hidden" asp-for="MarketId" />
            <input type="hidden" asp-for="MarketName" />
            <input type="hidden" asp-for="BuyerId" />
            <input type="hidden" asp-for="TotalPrice" />

            <div class="d-flex gap-2 mt-4">
                <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">Back to Cart</a>
                <button type="submit" class="btn btn-dark">Confirm ✅</button>
            </div>
        </form>
    </div>
</div>