@model LINCA_v1.Models.Productsprop
@{
    ViewData["Title"] = "Delete Product";
}

<style>
    :root {
        --bg: #eef5e9;
        --grid: #d8e6d3;
        --card: #ffffffcc;
        --text: #0c1a0f;
        --muted: #2b3b2f;
        --primary: #a7d9a8;
        --primaryHover: #94c996;
        --danger: #e26d6d;
        --shadow: 0 18px 40px rgba(0,0,0,.08);
        --radius: 22px;
        --greenText: #2f8a3a;
    }

    body {
        background: var(--bg);
        background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg,var(--grid) 1px, transparent 1px);
        background-size: 40px 40px;
    }

    .wrap {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px;
    }

    .card {
        width: min(820px,100%);
        background: var(--card);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.55);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 38px;
        text-align: center;
    }

    .title {
        font-size: 34px;
        font-weight: 900;
        letter-spacing: 2px;
        margin: 0 0 8px;
        color: var(--greenText);
        text-shadow: 0 6px 12px rgba(0,0,0,.08);
    }

    .meta {
        color: var(--muted);
        font-weight: 800;
        font-size: 16px;
        margin-top: 8px;
    }

    .actions {
        margin-top: 22px;
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-soft {
        border: 1px solid rgba(0,0,0,.10);
        background: rgba(167,217,168,.35);
        font-weight: 900;
        padding: 10px 16px;
        border-radius: 14px;
        text-decoration: none;
        color: var(--muted);
        transition: .15s ease;
    }

        .btn-soft:hover {
            background: rgba(167,217,168,.55);
        }

    .btn-danger {
        border: 0;
        background: #ffdddd;
        font-weight: 900;
        padding: 10px 16px;
        border-radius: 14px;
        color: #6b0000;
        cursor: pointer;
        transition: .15s ease;
    }

        .btn-danger:hover {
            background: #ffbbbb;
        }
</style>

<div class="wrap">
    <div class="card">
        <div class="title">Delete Product</div>
        <div class="meta">
            Are you sure you want to delete: <b>@Model.ProductName</b> ?
        </div>

        <form asp-action="Delete" method="post" style="margin-top:18px;">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductId" />

            <div class="actions">
                <a class="btn-soft" asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId">
                    Cancel
                </a>
                <button type="submit" class="btn-danger">Yes, Delete</button>
            </div>
        </form>
    </div>
</div>