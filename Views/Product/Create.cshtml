@model LINCA_v1.Models.Productsprop

@{
    ViewData["Title"] = "Create Product";
    var marketId = (int)(ViewBag.MarketId ?? Model.MarketId);
    var marketName = ViewBag.MarketName as string ?? "My Store";
}

<style>
    :root {
        --bg: #eef5e9;
        --grid: #d8e6d3;
        --card: #ffffffcc;
        --text: #0c1a0f;
        --muted: #2b3b2f;
        --primary: #a7d9a8;
        --primaryHover: #94c996;
        --shadow: 0 18px 40px rgba(0,0,0,.08);
        --radius: 22px;
        --greenText: #2f8a3a;
    }

    body {
        background-color: var(--bg);
        background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
        background-size: 40px 40px;
    }

    .wrap {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px;
    }

    .card {
        width: min(820px, 100%);
        background: var(--card);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.55);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 42px;
    }

    .title {
        text-align: center;
        font-size: 36px;
        font-weight: 900;
        letter-spacing: 4px;
        margin: 0 0 6px;
        color: var(--greenText);
        text-shadow: 0 6px 12px rgba(0,0,0,.08);
    }

    .subtitle {
        text-align: center;
        margin: 0 0 18px;
        color: var(--muted);
        font-weight: 800;
        opacity: .9;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-top: 12px;
    }

    label {
        font-weight: 900;
        color: var(--muted);
        font-size: 13px;
    }

    input, textarea {
        width: 100%;
        border-radius: 14px;
        border: 1px solid rgba(0,0,0,.10);
        padding: 12px;
        outline: none;
        background: rgba(255,255,255,.8);
        font-weight: 700;
        color: var(--text);
        transition: 0.15s ease;
    }

        input:focus, textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 2px rgba(167,217,168,.35);
        }

    textarea {
        min-height: 120px;
        resize: vertical;
    }

    .actions {
        margin-top: 18px;
        display: flex;
        gap: 10px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-soft, .btn-primary {
        border-radius: 14px;
        font-weight: 900;
        padding: 10px 16px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .15s ease;
        cursor: pointer;
    }

    .btn-soft {
        border: 1px solid rgba(0,0,0,.10);
        background: rgba(167,217,168,.35);
        color: var(--muted);
    }

        .btn-soft:hover {
            background: rgba(167,217,168,.55);
        }

    .btn-primary {
        border: 0;
        background: var(--primary);
        color: var(--text);
    }

        .btn-primary:hover {
            background: var(--primaryHover);
        }

    .alert {
        border-radius: 14px;
        font-weight: 800;
        margin: 0 0 12px;
        padding: 10px 14px;
    }

    .alert-success {
        background: rgba(167,217,168,.35);
        border: 1px solid rgba(0,0,0,.08);
    }

    .alert-danger {
        background: rgba(226,109,109,.18);
        border: 1px solid rgba(0,0,0,.08);
    }

    @@media (max-width:900px) {
        .card {
            padding: 34px 20px;
        }

        .title {
            font-size: 32px;
        }
    }
</style>

<div class="wrap">
    <div class="card">
        <div class="title">Create Product</div>
        <div class="subtitle">Store: <b>@marketName</b></div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <form asp-controller="Product" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            @* ✅ أهم سطر: لازم MarketId ينرسل بالبوست *@
            <input type="hidden" name="MarketId" value="@marketId" />

            <div asp-validation-summary="All" class="text-danger" style="font-weight:800;"></div>

            <div class="field">
                <label asp-for="ProductName">Product Name</label>
                <input asp-for="ProductName" placeholder="e.g. Handmade Keychain" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Price">Price (JD)</label>
                <input asp-for="Price" type="number" step="0.01" placeholder="e.g. 3.00" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="imgurl">Image URL</label>
                <input asp-for="imgurl" placeholder="https://.../product.jpg" />
                <span asp-validation-for="imgurl" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" placeholder="Write a short description..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="actions">
                <a class="btn-soft"
                   asp-controller="Product"
                   asp-action="ByMarket"
                   asp-route-marketId="@marketId">← Back</a>

                <button type="submit" class="btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}