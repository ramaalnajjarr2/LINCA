@model List<LINCA_v1.Models.Productsprop>
@{
    ViewData["Title"] = "Products";
    var marketName = ViewBag.MarketName as string ?? "Shop";
    var marketId = (int)(ViewBag.MarketId ?? 0);
    var isSeller = (bool)(ViewBag.IsSeller ?? false);
}

<style>
    :root {
        --bg: #eef5e9;
        --grid: #d8e6d3;
        --card: #ffffffcc;
        --text: #0c1a0f;
        --muted: #2b3b2f;
        --primary: #a7d9a8;
        --primaryHover: #94c996;
        --shadow: 0 18px 40px rgba(0,0,0,.08);
        --radius: 22px;
        --greenText: #2f8a3a;
    }

    body {
        margin: 0;
        color: var(--text);
        background: var(--bg);
        background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg,var(--grid) 1px, transparent 1px);
        background-size: 40px 40px;
    }

    .wrap {
        min-height: calc(100vh - 120px);
        display: flex;
        justify-content: center;
        padding: 28px;
    }

    .card {
        width: min(1050px, 100%);
        background: var(--card);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.55);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 42px;
    }

    .title {
        text-align: center;
        font-size: 48px;
        font-weight: 900;
        letter-spacing: 6px;
        margin: 0 0 6px;
        color: var(--greenText);
        text-shadow: 0 10px 18px rgba(0,0,0,.08);
    }

    .subtitle {
        text-align: center;
        margin: 0 0 18px;
        color: var(--muted);
        font-weight: 700;
        opacity: .9;
    }

    .top-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
        flex-wrap: wrap;
        margin: 18px 0 10px;
    }

    .btn-soft, .btn-primary {
        border-radius: 14px;
        font-weight: 900;
        padding: 10px 16px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .15s ease;
        cursor: pointer;
        border: 0;
    }

    .btn-soft {
        border: 1px solid rgba(0,0,0,.10);
        background: rgba(167,217,168,.35);
        color: var(--muted);
    }

        .btn-soft:hover {
            background: rgba(167,217,168,.55);
        }

    .btn-primary {
        background: var(--primary);
        color: var(--text);
    }

        .btn-primary:hover {
            background: var(--primaryHover);
        }

    /* ✅ Grid مضبوط: auto-fit عشان الكروت تكون متساوية وتترتب لوحدها */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 18px;
        margin-top: 18px;
        align-items: stretch;
    }

    /* ✅ كرت عمودي (مش أفقي) عشان ما يطلع واحد طويل وواحد قصير */
    .product-card {
        border-radius: 22px;
        border: 1px solid rgba(0,0,0,.10);
        background: rgba(255,255,255,.78);
        box-shadow: 0 10px 18px rgba(0,0,0,.06);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform .14s ease, box-shadow .14s ease;
        min-height: 340px;
    }

        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 20px 36px rgba(0,0,0,.12);
        }

    /* ✅ صورة ثابتة */
    .thumb {
        width: 100%;
        height: 170px;
        background: rgba(255,255,255,.9);
        border-bottom: 1px solid rgba(0,0,0,.08);
    }

        .thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .noimg {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--muted);
        font-weight: 800;
        opacity: .75;
    }

    .content {
        padding: 16px 16px 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1;
    }

    .pname {
        font-size: 18px;
        font-weight: 900;
        line-height: 1.25;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 900;
        border: 1px solid rgba(0,0,0,.1);
        background: rgba(167,217,168,.35);
        color: var(--muted);
    }

    .price {
        font-size: 14px;
        font-weight: 900;
        color: var(--greenText);
        white-space: nowrap;
    }

    /* ✅ وصف “مرتب” وما يطوّل الكرت */
    .desc {
        font-size: 13px;
        color: var(--muted);
        opacity: .9;
        font-weight: 700;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 58px; /* يخلي الكروت متقاربة بالارتفاع */
    }

    .btn-more {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 12px;
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,.1);
        background: rgba(167,217,168,.35);
        font-weight: 900;
        font-size: 12px;
        width: fit-content;
        text-decoration: none;
        color: var(--muted);
    }

        .btn-more:hover {
            background: rgba(167,217,168,.55);
        }

    .empty {
        text-align: center;
        padding: 30px 10px;
        opacity: .85;
    }
</style>

<div class="wrap">
    <div class="card">
        <div class="title">Products</div>
        <div class="subtitle">Products in <b>@marketName</b></div>

        <div class="top-actions">
            <a class="btn-soft" asp-controller="Market" asp-action="Shop">← Back to Stores</a>

            @if ((bool)(ViewBag.CanAddProduct ?? false))
            {
                <a class="btn-primary"
                   asp-controller="Product"
                   asp-action="Create"
                   asp-route-marketId="@marketId">
                    + Add Product
                </a>
            }
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty">
                <h3>No Products Yet</h3>
                <div style="color:var(--muted); font-weight:700;">Coming soon</div>
            </div>
        }
        else
        {
            <div class="grid">
                @foreach (var p in Model)
                {
                    <div class="product-card">
                        <div class="thumb">
                            @if (!string.IsNullOrWhiteSpace(p.imgurl))
                            {
                                <img src="@p.imgurl" alt="@p.ProductName" />
                            }
                            else
                            {
                                <div class="noimg">No Image</div>
                            }
                        </div>

                        <div class="content">
                            <div class="pname">@p.ProductName</div>

                            <div class="row">
                                <span class="badge">Available</span>
                                <span class="price">@p.Price.ToString("0.00") JD</span>
                            </div>

                            <div class="desc">
                                @(string.IsNullOrWhiteSpace(p.Description) ? "—" : p.Description)
                            </div>

                            <a class="btn-more" asp-controller="Product" asp-action="Details" asp-route-id="@p.ProductId">
                                More info →
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>